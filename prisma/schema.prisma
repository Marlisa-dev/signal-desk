datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TicketStatus {
  open
  in_progress
  blocked
  closed
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  firstName   String
  lastName    String
  description String
  type        String
  attachment  String?
  status      TicketStatus @default(open)
  priority    String   @default("medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}